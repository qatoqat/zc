# Maintainer: qatoqat
# VCS variant: builds the latest commit from the main branch.
pkgname=zc-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Minimal terminal client for the ZCode agent runtime (no Electron), git version"
arch=('x86_64' 'aarch64')
url="https://github.com/qatoqat/zc"
license=('MIT')
depends=('gcc-libs' 'nodejs' 'curl')
optdepends=('zcode-bin: the ZCode runtime this client drives')
makedepends=('cargo' 'git')
provides=('zc')
conflicts=('zc')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd zc
  git describe --long --tags | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

prepare() {
  cd zc
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd zc
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release
}

package() {
  cd zc
  install -Dm755 target/release/zc "$pkgdir/usr/bin/zc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
